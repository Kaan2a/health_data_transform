# ─────────────────────────────────────────────
# CSV/API → FHIR Transformer — Environment Vars
# ─────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=fhir_user
POSTGRES_PASSWORD=fhir_local_pass
POSTGRES_DB=fhir_transformer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fhir_user:fhir_local_pass@postgres:5432/fhir_transformer

# ── Backend ──
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ──
STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=./uploads
# GCS_BUCKET_NAME=

# ── File Upload ──
MAX_UPLOAD_SIZE_MB=25

# ── Worker ──
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=300

# ── FHIR Validator ──
# FHIR_VALIDATOR_URL=http://fhir-validator:8080
