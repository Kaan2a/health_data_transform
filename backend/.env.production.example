APP_ENV=production
DEBUG=false

DATABASE_URL=postgresql+asyncpg://user:password@db_host:5432/db_name
SECRET_KEY=generate_a_strong_secret_key_here
JWT_EXPIRE_MINUTES=30

CORS_ORIGINS=https://app.yourdomain.com

STORAGE_BACKEND=gcs
STORAGE_BUCKET=your-gcs-bucket-name

FHIR_VALIDATOR_URL=https://your-fhir-validator-service

SSRF_PROTECTION_ENABLED=true
SSRF_ALLOW_PRIVATE_NETWORKS=false
SSRF_ALLOW_LOOPBACK=false
SSRF_ALLOW_LINK_LOCAL=false
SSRF_FOLLOW_REDIRECTS=false

API_CONNECT_TIMEOUT_SECONDS=5
API_READ_TIMEOUT_SECONDS=30
API_MAX_RESPONSE_SIZE_MB=20

FHIR_CONNECT_TIMEOUT_SECONDS=10
FHIR_READ_TIMEOUT_SECONDS=60
FHIR_MAX_RETRIES=3

LOG_LEVEL=INFO
LOG_FORMAT=json

SENTRY_DSN=
